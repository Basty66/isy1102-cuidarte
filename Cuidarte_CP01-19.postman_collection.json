                  "  else pm.expect(pm.response.code).to.eql(400);",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"nombre_usuario\": \"test_cp03\",\n  \"password\": \"abc123\",\n  \"correo\": \"cp03@test.cl\",\n  \"rut\": \"12.345.678-9\"\n}" },
            "url": { "raw": "{{base_url}}/autenticacion/registro", "host": ["{{base_url}}"], "path": ["autenticacion", "registro"] },
            "description": "Criterio: contraseña >=12 con 4 tipos de caracteres."
          }
        }
