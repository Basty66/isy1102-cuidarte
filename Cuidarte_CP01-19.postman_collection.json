                "exec": [
                  "pm.test('CP-04: 201 Created', () => pm.response.to.have.status(201));",
                  "pm.test('CP-04: latencia total — si >=5000ms => H-13 (delayMiddleware)', () => {",
                  "  if (pm.response.responseTime >= 4900) console.warn('H-13: delay de 5s presente, NFR-PERF-1 incumplido');",
                  "});",
                  "pm.test('CP-04: viene id', () => pm.expect(pm.response.json()).to.have.property('id'));",
                  "pm.test('CP-04: medico sin rol => 403 (probar con token_paciente)', () => true);"
                ],
                "type": "text/javascript"
              }
