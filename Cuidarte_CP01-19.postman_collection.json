    {
      "name": "CP-01 · Login y JWT",
      "item": [
        {
          "name": "1. Login exitoso (dr_rojas)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('CP-01: HTTP 200', () => pm.response.to.have.status(200));",
                  "pm.test('CP-01: viene token', () => { const j = pm.response.json(); pm.expect(j).to.have.property('token'); pm.collectionVariables.set('token_medico', j.token); });",
                  "pm.test('CP-01: latencia <300ms (ERS NFR-PERF-1)', () => pm.expect(pm.response.responseTime).to.be.below(300));",
                  "const p = JSON.parse(atob(pm.response.json().token.split('.')[1]));",
                  "pm.test('CP-01: payload con rol', () => pm.expect(p).to.have.property('rolNombre'));",
                  "pm.test('CP-01 OBS: exp <=15min (RF-1.2) — si falla => H-09', () => pm.expect((p.exp - p.iat) / 60).to.be.at.most(15));"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"nombre_usuario\": \"dr_rojas\",\n  \"password\": \"PASSWORD_DEL_DUMP\"\n}" },
            "url": { "raw": "{{base_url}}/autenticacion/login", "host": ["{{base_url}}"], "path": ["autenticacion", "login"] },
            "description": "Objetivo RF-1.1. Esperado: 200 + token. Si contraseña en BD es texto plano => H-01 (verificar con psql)."
          }
        },
        {
          "name": "2. Login con password inválida",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('CP-01: 401 Credenciales inválidas', () => { pm.response.to.have.status(401); const j = pm.response.json(); pm.expect(j.error).to.eql('Credenciales inválidas'); });",
                  "pm.test('CP-01 OBS: no expone glosa de BD (H-15)', () => { const g = (pm.response.json().glosa||''); pm.expect(g).to.not.match(/relation|column|syntax/i); });"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"nombre_usuario\": \"dr_rojas\",\n  \"password\": \"clave_incorrecta_123\"\n}" },
            "url": { "raw": "{{base_url}}/autenticacion/login", "host": ["{{base_url}}"], "path": ["autenticacion", "login"] }
          }
        },
        {
          "name": "3. SQLi clásico en login (CP-10 parcial)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('CP-10: 401 ante SQLi', () => pm.response.to.have.status(401));",
                  "pm.test('CP-10: sin 500 ni error SQL', () => { const b = pm.response.text(); pm.expect(b).to.not.match(/SQLSTATE|syntax error|pg_/i); });"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"nombre_usuario\": \"' OR '1'='1\",\n  \"password\": \"' OR '1'='1\"\n}" },
            "url": { "raw": "{{base_url}}/autenticacion/login", "host": ["{{base_url}}"], "path": ["autenticacion", "login"] },
            "description": "Req NFR-SEG-5. Esperado: 401. Si da 200 => autenticación rota."
          }
        },
        {
          "name": "4. Payload DROP TABLE (CP-10)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('CP-10: 401 y tabla intacta', () => pm.response.to.have.status(401));"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"nombre_usuario\": \"'; DROP TABLE usuarios;--\",\n  \"password\": \"x\"\n}" },
            "url": { "raw": "{{base_url}}/autenticacion/login", "host": ["{{base_url}}"], "path": ["autenticacion", "login"] }
          }
